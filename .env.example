# Copy to .env and fill in to enable the real integrations. Without these,
# the agent runs fully offline: rule-based classification instead of Gemini,
# and dry-run (logged, not actually sent) SMS instead of Twilio.

GEMINI_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: used by the n8n "Is Emergency?" escalation branch.
ON_CALL_MANAGER_PHONE=
